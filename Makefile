.PHONY: help install dev fmt lint type test cov security check run api migrate revision up down

help:
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-14s\033[0m %s\n", $$1, $$2}'

install:  ## Install runtime dependencies
	pip install -r requirements.txt

dev:  ## Install package with dev extras (editable)
	pip install -e ".[dev]"

fmt:  ## Auto-format with ruff
	ruff format app tests
	ruff check --fix app tests

lint:  ## Lint with ruff
	ruff check app tests
	ruff format --check app tests

type:  ## Type-check with mypy (strict)
	mypy app

test:  ## Run tests
	pytest

cov:  ## Run tests with coverage gate (core logic packages; see pyproject source)
	pytest --cov --cov-report=term-missing --cov-fail-under=80

security:  ## Run security scanners
	bandit -q -c pyproject.toml -r app
	pip-audit -r requirements.txt

check: lint type test security  ## Run the full quality gate

run:  ## Run the bot (long-poll)
	python -m app.main

api:  ## Run the FastAPI metrics service
	uvicorn app.api.main:app --host $${API_HOST:-127.0.0.1} --port $${API_PORT:-8080}

migrate:  ## Apply migrations
	alembic upgrade head

revision:  ## Create an autogenerated migration: make revision m="message"
	alembic revision --autogenerate -m "$(m)"

up:  ## Start the full docker stack
	docker compose up --build -d

down:  ## Stop the docker stack
	docker compose down
