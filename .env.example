# ===========================================================================
# Volunteers Bot — environment configuration
# Copy to .env and fill in. NEVER commit the real .env.
# ===========================================================================

# --- Telegram --------------------------------------------------------------
BOT_TOKEN=123456:ABC-DEF...
# Comma-separated Telegram user IDs (bot admins). These users get an automatic
# DB stub (no full registration), can always use /admin, and keep their role.
ADMIN_IDS=111111111,222222222
# Optional: explicit super-admins; if empty, ADMIN_IDS are treated as super-admins.
SUPER_ADMIN_IDS=
# Admin group chat id (negative for supergroups, e.g. -1001234567890).
ADMIN_GROUP_ID=-1001234567890
# Optional: forum topic id for support tickets (same supergroup).
# ADMIN_TICKET_TOPIC_ID=12345

# --- Redis (REQUIRED) — FSM, rate limits, cooldowns, metrics, queues -------
REDIS_URL=redis://localhost:6379/0
# NEWS_QUEUE_KEY=volunteers_bot:news_queue
# FSM_REDIS_KEY_PREFIX=fsm
# FSM_TTL_SEC=86400          # abandoned FSM flows expire after this many seconds

# --- Database --------------------------------------------------------------
# sqlite (default, dev only) or PostgreSQL (recommended for prod):
# DATABASE_URL=sqlite+aiosqlite:///./volunteers_bot.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/volunteers
# Apply schema: alembic upgrade head (tables are not created at startup).

# Used by docker-compose for the bundled postgres service:
# POSTGRES_USER=volunteers
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=volunteers

# --- Observability ---------------------------------------------------------
# JSON_LOGS=1
# LOG_LEVEL=INFO
# SENTRY_DSN=
# LOG_HASH_SALT=change-me     # salt for masking Telegram IDs in logs

# --- Broadcast / news worker (~25 msg/sec default) -------------------------
BROADCAST_BATCH_SIZE=25
BROADCAST_DELAY_SEC=0.05
# NEWS_MESSAGES_PER_SEC=25
# NEWS_MAX_RETRIES=3
# NEWS_RETRY_BASE_DELAY_SEC=0.5
# NEWS_DLQ_KEY=volunteers_bot:news_dlq

# --- Rate limiting & anti-spam (Redis-backed, multi-worker safe) -----------
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_SEC=60
# Seconds between new support tickets or suggestions per user (0 disables).
CREATION_COOLDOWN_SEC=45

# --- Shift scheduling + reminders ------------------------------------------
# DEFAULT_EVENT_TZ=Asia/Tashkent
# REMINDERS_DUE_KEY=volunteers_bot:reminders:due
# REMINDERS_DLQ_KEY=volunteers_bot:reminders:dlq
# REMINDERS_POLL_INTERVAL_SEC=30
# CHECKOUT_NUDGE_DELAY_MIN=15
# LEADERBOARD_SIZE=10

# --- Google Sheets (optional reporting) ------------------------------------
# Provide EITHER a path to the service-account JSON ...
# GOOGLE_CREDENTIALS_PATH=/run/secrets/google-sa.json
# ... OR the JSON contents inline (preferred for containers/secret managers):
# GOOGLE_CREDENTIALS_JSON=
# GOOGLE_SHEET_ID=spreadsheet_id_from_url

# --- Optional REST metrics API ---------------------------------------------
# Run: uvicorn app.api.main:app --host 127.0.0.1 --port 8080
# API_ENABLE=0
# API_HOST=127.0.0.1
# API_PORT=8080
# API_KEY=                     # REQUIRED to expose /metrics; constant-time checked
# API_CORS_ORIGINS=            # comma-separated allowlist (empty = none)
